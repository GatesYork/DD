{
  "name": "designated-driver",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:mobile": "npm run dev --workspace @dd/mobile",
    "dev:admin": "npm run dev --workspace @dd/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build --workspace @dd/admin && npm run build --workspace @dd/mobile",
    "test:e2e:cloud": "node scripts/test-e2e-cloud.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.56.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
